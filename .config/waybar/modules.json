{
  "custom/fedora": {
    "format": "", // feel free to change the icon to w/e distro you're using
    "tooltip": true,
    "tooltip-format": "existing is a given; living is a choice.",
    "on-click": "sh ~/.config/wofi/wofi_session.sh",
    "on-click-middle": "wofi --show drun ~/.config/wofi/config --style ~/.config/wofi/style.css",
  },
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "use-icon": true,
    "format": "<span>{icon}</span>",
    "format-icons": {
      "urgent": "",
      "active": "",
      "default": ""
    }
  },
  "mpris": {
    "format": "{player_icon} {artist} - {title}",
    "format-paused": "{status_icon} {artist} - {title}",
    "max-length": 45,
    "ellipsis": "…",
    "tooltip-format-playing": "{artist} - {title}",
    "tooltip-format-paused": "(Paused) {artist} - {title}",
    "tooltip-format": "Nothing playing at the moment.",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "ignored-players": ["firefox", "chrome", "chromium"], // add players to ignore here if you need
    "player-icons": {
      "default": "",
      "spotify": "",
      "mpv": "",
      "vlc": "",
    },
    "status-icons": {
    	"playing": "",
    	"paused": "",
    	"stopped": ""
    }
  },
 "custom/mic": {
  "return-type": "json",
  "interval": 5,
  "tooltip": true,
  "format": "{text}",
  "exec": "~/.config/waybar/scripts/waybar_microphone_use_indicator.sh",
},
"custom/screencast": {
  "return-type": "json",
  "interval": 5,
  "tooltip": true,
  "format": "{text}",
  "exec": "~/.config/waybar/scripts/waybar_screencast_indicator.sh",
  },
  "gamemode": {
    "format": "{glyph}",
    "format-alt": "{glyph} {count}",
    "glyph": "",
    "hide-not-running": true,
    "use-icon": true,
    "icon-name": "input-gaming-symbolic",
    "icon-spacing": 4,
    "icon-size": 20,
    "tooltip": false,
    "tooltip-format": "Games running: {count}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip": true,
    "tooltip-format-activated": "Enabled",
    "tooltip-format-deactivated": "Disabled",
    "on-click-middle": "control --battery"
  },
"custom/docker": {
  "exec": "~/.config/waybar/scripts/waybar_docker_indicator.sh",
  "interval": 10,
  "return-type": "json",
  "format": "{icon}",
  "format-icons": {
    "default": ""
  },
  "tooltip": true, // TODO: add uptime on tooltip
  },
  "bluetooth": {
    // "format": "󰂯 {status}",
   "format-on": "<span size=\"13000\">󰂯</span>",
   "format-off": "<span size=\"13000\">󰂲</span>",
   "format-disabled": "<span size=\"13000\">󰂲</span>",
   "format-connected": "<span size=\"13000\">󰂱</span> {device_alias}",
    "tooltip": true,
    "tooltip-format": "Awaiting connection",
    "tooltip-format-disabled": "Bluetooth device disabled",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "Connected @ {device_alias}",
    "on-click": "bash -c 'bluetoothctl show | grep -q \"Powered: yes\" && bluetoothctl power off || bluetoothctl power on'",
    // "on-click-middle": "blueman-manager", // alternatively you can use blueman-manager
    "on-click-middle": "control --bluetooth",
    "class": "{status}"
  },
  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}",
    "format-muted": "",
    "tooltip": true,
    "tooltip-format": "{volume}%",
    "tooltip-format-muted": "Volume muted",
    "format-icons": {
      "default": ["", "", ""]
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle", // mute on click
    "on-click-middle": "control --volume",
    // "on-click-middle": "pwvucontrol", // alternatively you can use pwvucontrol or pavucontrol
    "on-click-right": "~/.config/wofi/wofi_audio.sh"
  },
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "",
    "format-disconnected": "󰌙",
    "tooltip-format": "Connected @ {essid}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤢", "󰤨"],
    // "on-click-middle": "nm-connection-editor", // alternatively you can use nm-connection-editor
    "on-click-middle": "control --wifi"
  },
  "cpu": {
    "format": "  {usage}%",
    "tooltip": true,
    "on-click-middle": "gnome-system-monitor"
  },
  "memory": {
    "format": "  {}%",
    "tooltip": true,
    "on-click-middle": "gnome-system-monitor"
  },
  "custom/gpu_temperature": {
    "interval": 5,
    "return-type": "json",
    "exec": "~/.config/waybar/scripts/waybar_gpu_temperature.sh",
    "on-click-middle": "flatpak run io.github.ilya_zlobintsev.LACT"
  },
  "hyprland/language": {
    "format": " {long}",
    "on-click-middle": "sh -c 'hyprctl switchxkblayout current next >/dev/null 2>&1; notify-send \"waybar\" \"Keyboard layout changed.\"'"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-full": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-alt": "{time}  {icon}",
    "format-icons": ["", "", "", "", ""],
    "on-click-middle": "control --battery",
  },
  "clock": {
    "format": "{:%a, %e  |  %H:%M} ",
    "tooltip-format": "{:%d-%m-%Y}",
    "on-click-middle": "gnome-calendar"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 5
  }
}
