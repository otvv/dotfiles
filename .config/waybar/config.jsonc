{
  "reload_style_on_change": true, // reload bar style on change
  "layer": "top", // waybar at top layer
  "position": 10, // custom waybar position (top|bottom|left|right)
  // "width": 2560, // custom waybar width
  "spacing": 3, // gaps between modules
  "exclusive": true,
  "margin-left": 5,
  "margin-right": 5,
  "margin-top": 5,

  // order of the modules
  "modules-left": ["custom/fedora", "hyprland/workspaces"],
  "modules-center": ["mpris", "cpu", "memory", "custom/gpu_temperature"],
  "modules-right": [
    "idle_inhibitor",
    "custom/screencast",
    "custom/mic", 
    "custom/docker",
    "gamemode",
    "network",
    "pulseaudio",
    "bluetooth",
    "hyprland/language",
    "clock",
    "tray",
  ],

  // custom module resources configuration
  "include": ["~/.config/waybar/modules.json"],
}
